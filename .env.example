# Copy this file to .env and fill in the values
# .env is NOT committed to git

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (leave empty to use SQLite locally)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (Resend API)
RESEND_API_KEY=your-resend-api-key

# OpenAI (Molly mockup all-over color prompt — optional)
# OPENAI_API_KEY=sk-...

# White catalog import API (desktop app integration).
# Shared secret sent by the desktop app in the X-API-Token header.
# Empty value disables the API. Local dev falls back to 'dev-local-token'.
# WHITE_CATALOG_API_TOKEN=choose-a-long-random-secret

# Media Storage (DigitalOcean Spaces - leave empty to use local /media/)
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=nyc3
# CDN_DOMAIN=media.yourdomain.com
